#!/usr/bin/env sh
echo "📝 Validating commit message format..."
msg=$(head -n 1 "$1")
pattern="^(feat|fix|perf|refactor|style|test|docs|build|ci|chore|revert)(\([a-z0-9_-]+\))?: .{8,100}$"
if ! echo "$msg" | grep -Eq "$pattern"; then
  echo ""
  echo "❌ Invalid commit message: '$msg'"
  echo "Format must be: <type>(<scope>): <subject>"
  echo "Example: feat(ast): add 250-line rule visitor"
  echo ""
  exit 1
fi
echo "✅ Commit message is valid."
